# Copy to .env and change before putting the server anywhere public.
POSTGRES_PASSWORD=whg-local-dev
# Port the game and API are served on.
API_PORT=8080
# Port Postgres is exposed on (this computer only), for database tools.
DB_PORT=5433
# What friends on your Wi-Fi open to join races (find your IP with ipconfig).
PUBLIC_URL=http://192.168.1.20:8080
